<UserControl
    x:Class="DesktopPanels.Views.WeatherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DesktopPanels.Views">
    <Grid Padding="16,8,16,12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:WeatherArt x:Name="Art" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TempText" FontSize="36" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="ConditionText" FontSize="14" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                    <TextBlock x:Name="CityText" FontSize="13" Foreground="#CCFFFFFF" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Week" Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="StatusText" Foreground="#EEFFFFFF" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
