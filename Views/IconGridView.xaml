<UserControl
    x:Class="DesktopPanels.Views.IconGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DesktopPanels.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:WrapPanel x:Name="Tiles" Margin="10,34,10,12" />
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Text="Nothing to show" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#CCFFFFFF" FontSize="14" IsHitTestVisible="False" />
    </Grid>
</UserControl>
