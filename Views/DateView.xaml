<UserControl
    x:Class="DesktopPanels.Views.DateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="DateRoot" Padding="16,8" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="DateText" HorizontalAlignment="Center" TextAlignment="Center"
                       FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock x:Name="DayText" Grid.Row="1" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,4,0,0" Foreground="#E6FFFFFF" TextWrapping="NoWrap"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
        </Grid>
        <Grid x:Name="CalendarRoot" Visibility="Collapsed" Padding="8,2,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="NavRow" ColumnSpacing="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MonthBackButton" Style="{StaticResource NavButton}" Click="OnPreviousMonth"
                        PointerEntered="OnNavEntered" PointerExited="OnNavExited"
                        AutomationProperties.Name="Previous month" ToolTipService.ToolTip="Previous month">
                    <TextBlock x:Name="MonthBackText" Text="&#x2039;" FontFamily="Segoe UI" Foreground="White" FontSize="22" />
                </Button>
                <TextBlock x:Name="MonthTitle" Grid.Column="1" HorizontalAlignment="Stretch" TextAlignment="Center"
                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                <Button x:Name="MonthForwardButton" Grid.Column="2" Style="{StaticResource NavButton}" Click="OnNextMonth"
                        PointerEntered="OnNavEntered" PointerExited="OnNavExited"
                        AutomationProperties.Name="Next month" ToolTipService.ToolTip="Next month">
                    <TextBlock x:Name="MonthForwardText" Text="&#x203A;" FontFamily="Segoe UI" Foreground="White" FontSize="22" />
                </Button>
            </Grid>
            <Grid x:Name="WeekdayHeader" Grid.Row="1" Margin="0,6,0,2" IsHitTestVisible="False" />
            <Grid x:Name="DayHost" Grid.Row="2" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
