<UserControl
    x:Class="DesktopPanels.Views.ClockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DesktopPanels.Views">
    <Grid>
        <Grid x:Name="DigitalRoot" Padding="16,8" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="TimeRow" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeText" FontWeight="SemiBold" Foreground="White"
                       FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" />
            <StackPanel x:Name="Meridiem" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="2">
                <TextBlock x:Name="AmText" Text="AM" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="PmText" Text="PM" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
        </Grid>
            <TextBlock x:Name="CityText" Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#E6FFFFFF" />
        </Grid>
        <Grid x:Name="SwissRoot" Visibility="Collapsed" Padding="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <views:SwissClockFace x:Name="Face" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <TextBlock x:Name="SwissCity" Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Foreground="#E6FFFFFF" FontSize="14" />
        </Grid>
    </Grid>
</UserControl>
